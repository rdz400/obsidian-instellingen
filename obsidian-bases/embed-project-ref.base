formulas:
  root-folder: file.folder.split("/")[0]
  unieke-links: file.links.unique()
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasLink(link(this.file))
        - file.path.split('/')[0] != '0-dagelijks'
    groupBy:
      property: formula.root-folder
      direction: ASC
    order:
      - file.name
      - datum
      - type
    sort:
      - property: file.name
        direction: ASC
      - property: file.links
        direction: ASC
    columnSize:
      file.name: 335
  - type: table
    name: InclusiefDagelijks
    filters:
      and:
        - file.hasLink(link(this.file))
    groupBy:
      property: formula.root-folder
      direction: ASC
    order:
      - file.name
      - datum
      - type
      - file.tags
      - file.links
    sort:
      - property: file.name
        direction: ASC
      - property: file.links
        direction: ASC
    columnSize:
      file.name: 333
      note.datum: 105
      note.type: 82
  - type: cards
    name: Lijst
    filters:
      and:
        - file.hasLink(link(this.file))
        - file.path.split('/')[0] != '0-dagelijks'
    groupBy:
      property: formula.root-folder
      direction: ASC
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
      - property: file.links
        direction: ASC
    columnSize:
      file.name: 335
    cardSize: 280
