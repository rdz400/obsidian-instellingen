filters:
  and:
    - file.folder.startsWith("0-inbox")
views:
  - type: table
    name: Table
    order:
      - file.name
      - datum
      - file.ctime
      - file.backlinks
      - file.links
      - file.tags
      - type
      - file.basename
    sort:
      - property: datum
        direction: DESC
      - property: file.basename
        direction: DESC
      - property: file.name
        direction: ASC
      - property: file.ctime
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 384
