filters:
  and:
    - type == "project"
formulas:
  taken_backlinks: file.backlinks.filter(value.asFile().inFolder("1-taken"))
views:
  - type: table
    name: actief
    filters:
      and:
        - status.containsAny("actief", "backlog")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - formula.taken_backlinks
      - vandaag
      - eind
      - datum
      - herinnering
    sort:
      - property: vandaag
        direction: DESC
    columnSize:
      file.name: 422
      note.status: 110
      formula.taken_backlinks: 243
      note.vandaag: 84
  - type: table
    name: misschien
    filters:
      and:
        - status == "misschien"
    order:
      - file.name
      - status
      - datum
      - herinnering
      - formula.taken_backlinks
    sort:
      - property: herinnering
        direction: ASC
    columnSize:
      file.name: 344
      note.status: 89
      note.omschrijving: 603
      formula.taken_backlinks: 243
  - type: table
    name: leeg
    filters:
      and:
        - status.isEmpty()
    order:
      - file.name
      - status
      - datum
      - omschrijving
    columnSize:
      file.name: 344
  - type: table
    name: alles
    order:
      - file.name
      - status
      - eind
    sort:
      - property: status
        direction: ASC
  - type: table
    name: backlog
    filters:
      and:
        - status == "backlog"
    order:
      - file.name
      - status
      - formula.taken_backlinks
    columnSize:
      file.name: 344
      note.status: 110
  - type: table
    name: klaar
    filters:
      and:
        - status == "klaar"
    order:
      - file.name
      - status
      - eind
      - file.folder
    columnSize:
      file.name: 344
      note.status: 110
  - type: table
    name: geannuleerd
    filters:
      and:
        - status == "geannuleerd"
    order:
      - file.name
      - status
      - eind
      - file.folder
    columnSize:
      file.name: 344
      note.status: 110
  - type: table
    name: wachten
    filters:
      and:
        - status == "wachten"
    order:
      - file.name
      - status
      - eind
      - file.folder
    columnSize:
      file.name: 344
      note.status: 110
