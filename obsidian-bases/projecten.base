filters:
  and:
    - type == "project"
formulas:
  taken_backlinks: file.backlinks.filter(value.asFile().inFolder("1-taken"))
  Untitled: link("obsidian://ronald-tasks?query=" + file.name, "taken")
properties:
  formula.Untitled:
    displayName: taak-modal
views:
  - type: table
    name: actief
    filters:
      and:
        - '!status.contains("klaar")'
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - actief
      - refining
      - backlog
    order:
      - file.name
      - status
      - formula.taken_backlinks
      - formula.Untitled
      - vandaag
      - datum
      - streefdatum
    sort:
      - property: formula.Untitled
        direction: DESC
      - property: vandaag
        direction: DESC
    columnSize:
      file.name: 422
      note.status: 110
      formula.taken_backlinks: 151
      formula.Untitled: 100
      note.vandaag: 84
  - type: table
    name: misschien
    filters:
      and:
        - status == "misschien"
    order:
      - file.name
      - status
      - datum
      - herinnering
      - formula.taken_backlinks
      - tags
    sort:
      - property: herinnering
        direction: ASC
    columnSize:
      file.name: 344
      note.status: 89
      note.omschrijving: 603
      formula.taken_backlinks: 243
  - type: table
    name: leeg
    filters:
      and:
        - status.isEmpty()
    order:
      - file.name
      - status
      - datum
      - omschrijving
    columnSize:
      file.name: 344
  - type: table
    name: alles
    order:
      - file.name
      - status
      - eind
      - tags
      - formula.Untitled
      - formula.taken_backlinks
    sort:
      - property: status
        direction: ASC
  - type: table
    name: backlog
    filters:
      and:
        - status == "backlog"
    order:
      - file.name
      - status
      - formula.taken_backlinks
    columnSize:
      file.name: 344
      note.status: 110
  - type: table
    name: klaar
    filters:
      and:
        - status == "klaar"
    order:
      - file.name
      - status
      - eind
      - file.folder
    sort:
      - property: eind
        direction: DESC
    columnSize:
      file.name: 344
      note.status: 110
  - type: table
    name: geannuleerd
    filters:
      and:
        - status == "geannuleerd"
    order:
      - file.name
      - status
      - eind
      - file.folder
    columnSize:
      file.name: 344
      note.status: 110
  - type: table
    name: wachten
    filters:
      and:
        - status == "wachten"
    order:
      - file.name
      - status
      - eind
      - file.folder
    columnSize:
      file.name: 344
      note.status: 110
  - type: kanban
    name: kanban-streefdatum
    filters:
      and:
        - '!status.containsAny("geannuleerd", "misschien", "klaar")'
    groupBy:
      property: streefdatum
      direction: DESC
    groupOrder:
      - 2026-09-30
      - 2026-10-01
      - 2026-11-01
      - 2026-12-01
      - 2027-01-01
    order:
      - file.name
    sort: []
    columnSize:
      file.name: 422
      note.status: 110
      formula.taken_backlinks: 243
      formula.Untitled: 100
      note.vandaag: 84
    columnWidth: 290
  - type: kanban
    name: kanban-status
    filters:
      and:
        - '!status.containsAny("geannuleerd", "klaar")'
    groupBy:
      property: status
      direction: DESC
    groupOrder:
      - backlog
      - refining
      - actief
      - nu
    order:
      - file.name
    sort:
      - property: vandaag
        direction: DESC
    columnSize:
      file.name: 422
      note.status: 110
      formula.taken_backlinks: 243
      formula.Untitled: 100
      note.vandaag: 84
    columnWidth: 290
  - type: table
    name: tabel-status
    filters:
      and:
        - '!status.containsAny("geannuleerd", "klaar")'
    groupBy:
      property: status
      direction: DESC
    groupOrder:
      - misschien
      - backlog
      - actief
    order:
      - file.name
    sort:
      - property: vandaag
        direction: DESC
    columnSize:
      file.name: 422
      note.status: 110
      formula.taken_backlinks: 243
      formula.Untitled: 100
      note.vandaag: 84
    columnWidth: 290
