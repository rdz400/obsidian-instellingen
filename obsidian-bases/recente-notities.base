filters:
  and:
    - file.folder != "0-dagelijks"
views:
  - type: table
    name: Table
    filters:
      and:
        - datum >= (today() - duration('21d'))
    order:
      - file.name
      - file.folder
      - datum
      - file.links
      - file.backlinks
    sort:
      - property: datum
        direction: DESC
    columnSize:
      file.name: 416
