filters:
  and:
    - file.folder != "0-dagelijks"
views:
  - type: table
    name: Table
    filters:
      and:
        - datum >= (today() - duration('28d'))
    order:
      - file.name
      - file.folder
      - omschrijving
      - datum
      - type
      - file.links
      - file.backlinks
      - gebieden
      - file.tags
    sort:
      - property: datum
        direction: DESC
    columnSize:
      file.name: 286
      file.folder: 152
      note.omschrijving: 156
      file.links: 360
      file.backlinks: 205
      note.type: 72
