filters:
  and:
    - file.folder != "0-dagelijks"
views:
  - type: table
    name: Table
    filters:
      and:
        - datum >= (today() - duration('64d'))
    order:
      - file.name
      - datum
      - file.folder
      - type
      - omschrijving
      - file.links
      - file.backlinks
      - gebieden
      - file.tags
    sort:
      - property: datum
        direction: DESC
    columnSize:
      file.name: 351
      file.folder: 152
      note.type: 104
      note.omschrijving: 156
      file.links: 360
      file.backlinks: 205
